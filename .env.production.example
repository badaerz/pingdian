# Copy to .env.production on the server and chmod 600. Never commit the copy.
APP_VERSION=0.1.0-rc.1
STORY_FORGE_ENV_FILE=/opt/story-forge/.env.production
NEXT_PUBLIC_DEMO_LOCKED=false

# Server-side only. Keep both values outside the image and repository.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=45000
AI_MAX_INPUT_CHARS=24000
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_DAILY_REQUESTS=200

# Image generation is optional. Empty values force the labelled local fallback.
MODELSCOPE_API_TOKEN=
MODELSCOPE_API_BASE_URL=https://api-inference.modelscope.cn
MODELSCOPE_IMAGE_MODEL=Qwen/Qwen-Image
MODELSCOPE_IMAGE_TIMEOUT_MS=90000
