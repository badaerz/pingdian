# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/.superpowers/

# next.js
/.next/
/out/
/.worktrees/

# production
/build

# misc
.DS_Store
*.pem

# debug
/.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval artifacts
# raw-GC_*.json holds full model output plus the source passage — never commit it.
/evals/runs/raw-*
# Superseded golden-set drafts from the first build; safe to delete locally.
/evals/archive/
*.json.bak

# scratch probes
/scripts/.jiti-probe.mjs

# scratch probe outputs
/.probe-trash/

# build artifacts from local verification
/.next.prebuild.bak/
