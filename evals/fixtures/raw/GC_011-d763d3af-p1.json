        "ev_001",
        "ev_004",
        "ev_008",
        "ev_009",
        "ev_012"
      ]
    },
    {
      "id": "an_pov",
      "name": "视角一致性",
      "summary": "全篇跟随老栓的所见所感（看见丁字街、看灯笼、看人群后背、觉得发冷），心理动词均落在老栓身上，未见越界。",
      "impact": "限制视角使读者与老栓同步无知，末句馒头的冲击因此更强。",
      "suggestion": "保持老栓单一视角，避免在人群段插入他人内心。",
