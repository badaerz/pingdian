          "id": "goal_01",
          "text": "太后胡氏营建永宁寺以征信法、彰功德",
          "evidenceIds": [
            "ev_005",
            "ev_014"
          ]
        }
      ],
      "actions": [
        {
          "id": "act_01",
          "text": "掘基至黄泉下，得金像三十躯，遂营建过度",
          "evidenceIds": [
            "ev_005"
          ]
        },
        {
          "id": "act_02",
          "text": "装饰毕功后，明帝与太后共登浮图，视宫内如掌中",
          "evidenceIds": [
            "ev_014"
          ]
        },
        {
          "id": "act_03",
          "text": "诏中书舍人常景为寺碑文",
          "evidenceIds": [
            "ev_012"
          ]
        }
      ],
      "relationshipChanges": [
        {
          "id": "rel_01",
          "text": "太后与明帝由营建者转为共同登临者，并因“目见宫中”而下禁人升之令，权力观看关系由此确立",
          "evidenceIds": [
            "ev_014"
          ]
        }
      ]
    },
    "plot": {
      "turningPoints": [
        {
          "id": "tp_01",
          "text": "掘基得金像三十躯，被释为信法之征，营建由工程转为过度之举",
          "evidenceIds": [
