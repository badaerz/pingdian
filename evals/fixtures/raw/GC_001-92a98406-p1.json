  "analysis": [
    {
      "id": "an_01",
      "name": "结构组织",
      "summary": "全文以“寺—浮图—佛殿—门楼—登临”逐层展开，四段各归其位：首段建场并推进，二段推进佛殿形制，三段推进门楼与碑文，末段以登临收束，无归不进去的段落。",
      "impact": "空间由外而内、由下而上，读者随文字逐级登高，形成清晰的营造账目式秩序。",
      "suggestion": "末段已具收束功能，可保留；若欲增强收束感，可让“禁人不听升之”与开篇“在宫前阊阖门南一里”形成一次方位回指。",
      "score": 88,
      "evidenceIds": [
        "ev_001",
        "ev_008",
        "ev_013",
        "ev_014"
      ]
    },
    {
      "id": "an_02",
      "name": "连贯衔接",
      "summary": "指代以“其寺”“其四门”“之”为主，先行词均为紧邻的寺、门、浮图，无悬空或歧义；相邻句主题词多围绕浮图构件（刹、瓶、盘、铎、铃）重叠，衔接紧密。",
      "impact": "密集的名物链条使文本读来如营造簿录，专业感强，读者不易迷失指代。",
      "suggestion": "“所可异者，唯楼两重”处主题词跳转稍快，可补一短句点明与南门楼三重的对照关系。",
      "score": 85,
      "evidenceIds": [
        "ev_002",
        "ev_009",
        "ev_011"
      ]
    },
    {
      "id": "an_03",
      "name": "信息密度与节奏",
      "summary": "全文以可指认实体与数据推进（九十丈、十丈、二十五斛、一十一重、一百三十铎、五千四百枚），无连续二百字零信息窗；单段虽长，但事件与具体名词持续产出。",
      "impact": "数字与名物的密集排列形成账目式节奏，与“营造账目”的题旨相合。",
      "suggestion": "第三段常景小传插入较长，可考虑将其压缩或另置，以免打断门楼形制的空间节奏。",
      "score": 82,
      "evidenceIds": [
        "ev_003",
        "ev_006",
        "ev_007",
        "ev_012"
      ]
    },
    {
      "id": "an_04",
      "name": "具体性与感官",
      "summary": "感官覆盖视觉（朱漆、金铃、青槐、绿水）与听觉（宝铎和鸣、铿锵之声闻及十馀里）两类，转折处“得金像三十躯”为可指认物件，具象充足。",
      "impact": "视觉的金朱与听觉的铎声互证，使高塔在纸面上可闻可望。",
      "suggestion": "嗅觉、触觉通道全缺，可在“藂竹香草”处略补气味，或在“高风永夜”处补风的触感，使登临更具身体性。",
      "score": 78,
      "evidenceIds": [
        "ev_004",
        "ev_007",
        "ev_010",
        "ev_013"
      ]
    },
    {
      "id": "an_05",
      "name": "意象复现",
      "summary": "“金铎/金铃”“浮图”跨段复现，且由“角角皆悬金铎”到“宝铎和鸣”发生功能位置变化——从构件转为声音事件，指向寺院由静态形制转为可感知的存在。",
      "impact": "同一物象在形制与声响之间转换，使建筑获得时间维度。",
      "suggestion": "可让末段登临时再闻铎声一次，使金铎意象在收束处完成第三次复现。",
      "score": 80,
      "evidenceIds": [
        "ev_007",
        "ev_010",
        "ev_014"
      ]
    },
    {
      "id": "an_06",
      "name": "视角一致性",
      "summary": "文本为志书式全知叙述，叙述者自由出入方位、数据与登临者所见，并插入“衒之尝与……共登之”的第一人称补证，属全知体的正当越出。",
      "impact": "全知视角使寺院形制得以整体呈现，末句的第一人称补证又添一层亲历可信度。",
      "suggestion": "若欲强化亲历感，可将“信哉不虚”前的登临描写稍作视角收窄，令读者先随衒之仰望再俯瞰。",
      "score": 84,
      "evidenceIds": [
        "ev_006",
        "ev_014"
      ]
    }
  ],
  "evidence": [
    {
      "id": "ev_001",
      "source": "observation",
      "quote": "永宁寺，熙平元年灵太后胡氏所立也，在宫前阊阖门南一里御道西。",
      "note": "开篇给出寺名、立寺者、年号与方位，完成建场。"
    },
    {
      "id": "ev_002",
      "source": "observation",
      "quote": "其寺东有太尉府，西对永康里，南界昭玄曹，北邻御史台。",
      "note": "以“其寺”回指前句永宁寺，指代明确，四邻方位铺陈。"
    },
    {
      "id": "ev_003",
      "source": "observation",
      "quote": "中有九层浮图一所，架木为之，举高九十丈。",
      "note": "转入浮图主体，给出层数与高度数据，属推进。"
    },
    {
      "id": "ev_004",
      "source": "observation",
      "quote": "上有金刹，复高十丈；合去地一千尺。",
      "note": "继续累加高度数据，具体可核验。"
    },
    {
      "id": "ev_005",
      "source": "observation",
      "quote": "初掘基至黄泉下，得金像三十躯，太后以为信法之征，是以营建过度也。",
      "note": "掘基得金像并释为祥瑞，是全文最明确的一处转折（营建性质由工程转为过度之举）。"
    },
    {
      "id": "ev_006",
      "source": "observation",
      "quote": "去京师百里，已遥见之。",
      "note": "以远距可见回收前文高度数据，形成前后照应。"
    },
    {
      "id": "ev_007",
      "source": "observation",
      "quote": "至于高风永夜，宝铎和鸣，铿锵之声，闻及十馀里。",
      "note": "听觉通道证据，金铎由构件转为声音事件。"
    },
    {
      "id": "ev_008",
      "source": "observation",
      "quote": "浮图北有佛殿一所，形如太极殿。",
      "note": "第二段起句，以“浮图北”承接上段方位，转入佛殿形制。"
    },
    {
      "id": "ev_009",
      "source": "observation",
      "quote": "僧房楼观，一千馀间，雕梁粉壁，青璅绮疏，难得而言。",
      "note": "以“难得而言”作评述句，同时给出可指认的建筑实体。"
    },
    {
      "id": "ev_010",
      "source": "observation",
      "quote": "栝柏椿松，扶疏檐霤，藂竹香草，布护阶墀。",
      "note": "植物名物铺陈，含“香草”可作嗅觉线索。"
    },
    {
      "id": "ev_011",
      "source": "observation",
      "quote": "其四门外，皆树以青槐，亘以绿水，京邑行人，多庇其下。",
      "note": "“其四门”回指前文四面各开一门，指代明确；视觉通道证据。"
    },
    {
      "id": "ev_012",
      "source": "observation",
      "quote": "诏中书舍人常景为寺碑文。",
      "note": "引入碑文与常景，属推进；其后小传为插入性说明。"
    },
    {
      "id": "ev_013",
      "source": "observation",
      "quote": "拱门有四力士、四狮子，饰以金银，加之珠玉，庄严焕炳，世所未闻。",
      "note": "门楼装饰的具体物件与材质，视觉通道证据。"
    },
    {
      "id": "ev_014",
      "source": "observation",
      "quote": "装饰毕功，明帝与太后共登之。视宫内如掌中，临京师若家庭，以其目见宫中，禁人不听升之。",
      "note": "末段收束：交代装饰完成、登临与禁令，人物处境终结，具收束功能。"
    },
    {
      "id": "ev_015",
      "source": "inference",
      "claim": "全文的叙述动力来自“数据—祥瑞—登临”三段递进，而非人物冲突。",
      "note": "由ev_003、ev_005、ev_014的数据累加、祥瑞解释与登临禁令可推出，属推断而非原文直述。"
    }
  ],
