  "evidence": [
    {
      "id": "ev_001",
      "source": "observation",
      "quote": "宣德间，宫中尚促织之戏，岁征民间。",
      "note": "开篇建立时代、宫廷趣味与征敛体制，是全文批判的起点。"
    },
    {
      "id": "ev_002",
      "source": "observation",
      "quote": "成名资产中匮，每责一头，往往泣下。",
      "note": "交代成名贫窘与被役处境，为后文祸福反转埋伏。"
    },
    {
      "id": "ev_003",
      "source": "observation",
      "quote": "于荒坟巨石之下捉得一头：体型硕大，双尾尾尖，色青而光。",
      "note": "捕得神虫，处境由绝望转为有望，是第一处转折与核心意象首次出现。"
    },
    {
      "id": "ev_004",
      "source": "observation",
      "quote": "窥父不在，窃发盆。蚤跃掷出，急捕之，杖促，折其股，压而毙之。",
      "note": "子毙虫，闯下灭顶之祸，构成第二处转折。"
    },
    {
      "id": "ev_005",
      "source": "observation",
      "quote": "母闻之，面如死灰，大骇曰：“业根！尔死期至矣！汝父回，自与汝算账！”",
      "note": "母亲反应具象（面如死灰）且有直接引语，是感官与人物刻画的关键证据。"
    },
    {
      "id": "ev_006",
      "source": "observation",
      "quote": "见投井死。夫妻向隅，茅舍无烟，相对默然，不复聊赖。",
      "note": "子死与家庭死寂，情感最低点，也是后文奇幻反转的心理势能。"
    },
    {
      "id": "ev_007",
      "source": "observation",
      "quote": "天子大悦，赐抚军良马锦缎，抚军赏令，令免成名赋税，田产骤富，裘马扬扬。",
      "note": "赏赐落实，处境由贫窘转为骤富，是结局性转折。"
    },
    {
      "id": "ev_008",
      "source": "observation",
      "quote": "小虫忽振翅一跃，直咬敌喉，敌立毙。又置于鸡前，小虫竟跳跃啄鸡冠，鸡退缩避走。",
      "note": "异虫连胜，意象形态与功能发生推进，是高潮段的核心具象动作。"
    },
    {
      "id": "ev_009",
      "source": "observation",
      "quote": "独是成氏子以蠹贫，以促织富，裘马扬扬。",
      "note": "评述点破祸福反转，与正文“裘马扬扬”形成呼应闭环。"
    },
    {
      "id": "ev_010",
      "source": "observation",
      "quote": "天将以福善祸淫，抑神怪所托耶？",
      "note": "末段以反问收束，质疑天道，是收束与主题提升的关键句。"
    }
  ],
