{
  "name": "story-forge-mvp",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:layering": "node scripts/check-layering.mjs",
    "check:filesize": "node scripts/check-filesize.mjs",
    "eval": "node scripts/run-eval.mjs",
    "eval:report": "node scripts/eval-report.mts",
    "eval:live": "node scripts/run-eval.mjs --live",
    "seed:supabase": "node scripts/seed-supabase.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:layering && npm run check:filesize && npm test -- --run && npm run build",
    "check:golden": "node scripts/check-golden-schema.mjs",
    "eval:fixtures": "node scripts/run-eval.mjs --live --fixtures",
    "golden:review": "node scripts/golden-review.mjs",
    "golden:apply": "node scripts/golden-review.mjs --apply"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.1",
    "gsap": "^3.15.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
